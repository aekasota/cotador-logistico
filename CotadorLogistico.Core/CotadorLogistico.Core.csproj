<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CotadorLogistico.Core</RootNamespace>

    <!-- Precisamos dos tipos do ASP.NET Core (WebApplication, HttpContext, etc.)
         mesmo sendo uma class library "comum". FrameworkReference resolve isso
         localmente (não baixa nada do NuGet), diferente de um PackageReference. -->
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging estruturado em arquivo local (ver Logging/AppLogging.cs). -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.3" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
