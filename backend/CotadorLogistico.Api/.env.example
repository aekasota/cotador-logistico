# Copie para ".env" (nesta mesma pasta) e preencha com os valores do seu
# projeto Supabase — ver docs/SUPABASE.md. Este arquivo nunca é lido em
# produção com valores reais commitados: ".env" já está no .gitignore.

SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_CONNECTION=Host=...;Port=5432;Database=postgres;Username=postgres;Password=...;SSL Mode=Require;Trust Server Certificate=true

CORS_ALLOWED_ORIGINS=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Development
# Deve bater com VITE_API_BASE_URL em frontend/CotadorLogistico.Web/.env.local
ASPNETCORE_URLS=http://localhost:5080

# Opcional (ver seção 9 do pedido de migração): domínios de e-mail
# esperados, separados por vírgula — hoje só fica disponível na
# configuração, nenhuma validação usa isto ainda.
# ALLOWED_EMAIL_DOMAINS=frenet.com.br,skydropx.com
