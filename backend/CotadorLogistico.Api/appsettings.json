{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Secrets": {
    "Mode": "Vault"
  },

  "Gemini": {
    "Model": "gemini-3.6-flash",
    "ApiBaseUrl": "https://generativelanguage.googleapis.com",
    "TimeoutSeconds": 20
  },

  "ExchangeRates": {
    "Currencies": [ "USD", "MXN" ],
    "ApiBaseUrl": "https://api.frankfurter.dev/v2",
    "CheckInterval": "01:00:00",
    "StaleAfter": "24:00:00"
  },

  "Cors": {
    "AllowedOrigins": "http://localhost:5173"
  },

  "Security": {
    "AllowedEmailDomains": ""
  }
}
