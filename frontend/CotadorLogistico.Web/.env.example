# Copie este arquivo para .env.local e preencha com os valores do seu
# projeto Supabase (ver docs/SETUP.md). Estas variáveis são PÚBLICAS — a
# publishable key é segura no navegador por design, desde que o RLS esteja
# ativo (ver seção 32 do pedido de migração). NUNCA coloque a secret key
# aqui nem em nenhum arquivo deste diretório.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXXXXXX

# URL base do backend ASP.NET Core (CotadorLogistico.Api).
VITE_API_BASE_URL=http://localhost:5080
